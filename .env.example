# ═══════════════════════════════════════════════════════
# ⚡ zivv — ملف المتغيرات السرية (مثال)
# ═══════════════════════════════════════════════════════
# انسخ الملف ده باسم:  .env
# وحط القيم الحقيقية فيه — الملف ده مش بيتنشر على جيت ولا Render
# (في Render: حط القيم من لوحة التحكم Environment → Environment Variables)

# مفتاح Resend (من https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# المرسل — من غير دومين: zivv <onboarding@resend.dev>
# (تنبيه: بيوصّل لإيميل حسابك إنت بس — عشان تبعت لأي حد محتاج دومين متحقق)
RESEND_FROM="zivv <onboarding@resend.dev>"

# نص سري لتقوية تشفير رموز OTP — غيّره لسلسلة طويلة عشوائية
OTP_SALT=put-a-long-random-string-here
